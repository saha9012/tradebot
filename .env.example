# Server
PORT=3000
DB_PATH=./data/bot.db

# Panel auth (future)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Rate limiter (ms between Steam requests; меньше = быстрее, но риск 429)
RATE_LIMIT_MIN_MS=1500
RATE_LIMIT_JITTER_MS=500

# simple = цены с market/search/render (DOM data-price), без histogram на каждый предмет
# full = старый путь (nameid + itemordershistogram)
BOT_MARKET_PRICE_MODE=simple
BOT_CATALOG_SYNC_MS=3600000
SCAN_TICK_MS=20000
SCAN_ITEMS_PER_TICK=5

# item_nameid через headless Chrome, если HTTP не даёт Market_LoadOrderSpread
SCAN_ITEMS_PER_TICK=5
# BOT_PLAYWRIGHT_HEADED=true
# BOT_VERBOSE_FETCH_DEBUG=true

# Фоновый режим при старте сервера
BOT_AUTO_LOGIN=false
BOT_AUTO_START_SCAN=false
BOT_AUTO_START_SELL=true
SCAN_TICK_MS=60000
SELL_TICK_MS=45000

# Account 1 — Dota
ACCOUNT_1_USERNAME=
ACCOUNT_1_PASSWORD=
ACCOUNT_1_SHARED_SECRET=
ACCOUNT_1_IDENTITY_SECRET=

# Account 2 — CS2 (stub)
ACCOUNT_2_USERNAME=
ACCOUNT_2_PASSWORD=
ACCOUNT_2_SHARED_SECRET=
ACCOUNT_2_IDENTITY_SECRET=

# Account 3 — Rust (stub)
ACCOUNT_3_USERNAME=
ACCOUNT_3_PASSWORD=
ACCOUNT_3_SHARED_SECRET=
ACCOUNT_3_IDENTITY_SECRET=
