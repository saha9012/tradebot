# Server
PORT=3000
DB_PATH=./data/bot.db

# Panel auth (future)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Rate limiter (ms between Steam requests; меньше = быстрее, но риск 429)
RATE_LIMIT_MIN_MS=2500
RATE_LIMIT_JITTER_MS=1000

# Фоновый режим при старте сервера
BOT_AUTO_LOGIN=false
BOT_AUTO_START_SCAN=false
BOT_AUTO_START_SELL=true
SCAN_TICK_MS=60000
SELL_TICK_MS=45000

# Account 1 — Dota
ACCOUNT_1_USERNAME=
ACCOUNT_1_PASSWORD=
ACCOUNT_1_SHARED_SECRET=
ACCOUNT_1_IDENTITY_SECRET=

# Account 2 — CS2 (stub)
ACCOUNT_2_USERNAME=
ACCOUNT_2_PASSWORD=
ACCOUNT_2_SHARED_SECRET=
ACCOUNT_2_IDENTITY_SECRET=

# Account 3 — Rust (stub)
ACCOUNT_3_USERNAME=
